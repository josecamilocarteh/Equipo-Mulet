<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>Equipo Jaime Mulet · Accesos Legislativos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#1f3552">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Mulet">
<style>
  :root{
    --ink:#16243a;--ink2:#1f3552;--bg:#e9edf2;--card:#ffffff;
    --teal:#0f766e;--blue:#1e3a5f;--amber:#d98324;
    --yellow:#c9941f;--pink:#c2447a;--red:#c23b3b;--green:#2f8f4e;
    --rk-mulet:#1e3a5f;--rk-tapia:#0f766e;--rk-santana:#c23b3b;
    --rk-olmos:#c9941f;--rk-urcullu:#7a4fc2;
    --text:#2b3a4f;--muted:#7c8aa0;--line:#dde3ec;
    --shadow:0 1px 3px rgba(22,36,58,.07),0 10px 30px rgba(22,36,58,.06);
    --drive-accent:#1a73e8;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
  a{text-decoration:none;color:inherit}
  .masthead{background:radial-gradient(120% 140% at 85% -10%,#243a5c 0%,transparent 55%),linear-gradient(180deg,var(--ink) 0%,var(--ink2) 100%);color:#fff;padding:44px 24px 38px;position:relative;overflow:hidden}
  .masthead::after{content:"";position:absolute;left:24px;right:24px;bottom:0;height:3px;background:linear-gradient(90deg,var(--amber) 0%,var(--amber) 64px,transparent 64px)}
  .mast-inner{max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
  .mast-left{flex:1;min-width:0}.mast-right{display:flex;align-items:center;flex-shrink:0}
  .mast-photo{width:60px;height:60px;border-radius:50%;flex-shrink:0;object-fit:cover;object-position:center top;border:2px solid rgba(255,255,255,.55);box-shadow:0 4px 14px rgba(0,0,0,.22)}
  @media(max-width:640px){.mast-photo{width:48px;height:48px}}
  .eyebrow{font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#9fb4d0;margin-bottom:10px}
  .mast-title{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:clamp(28px,6vw,46px);line-height:1.02;letter-spacing:-.01em;color:#fff}
  .mast-sub{margin-top:12px;font-size:14.5px;color:#b9c7dc;display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}
  .mast-sub .dot{width:4px;height:4px;border-radius:50%;background:#52688a}
  .pill{display:inline-block;border:1px solid #3a5079;color:#cdd9ea;border-radius:999px;padding:3px 11px;font-size:12.5px;font-weight:500}
  .layout{flex:1;max-width:1180px;width:100%;margin:0 auto;padding:34px 24px 8px;display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:start}
  @media(max-width:980px){.layout{grid-template-columns:1fr}}
  .section-label{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:8px 2px 16px}
  .section-label::after{content:"";flex:1;height:1px;background:var(--line)}
  .section-label.mt{margin-top:30px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:640px){.grid{grid-template-columns:1fr}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 22px 20px;display:flex;flex-direction:column;box-shadow:var(--shadow);border-left:4px solid var(--accent,var(--teal));transition:transform .18s ease,box-shadow .18s ease;outline:none}
  .card:hover,.card:focus-visible{transform:translateY(-3px);box-shadow:0 4px 10px rgba(22,36,58,.10),0 18px 40px rgba(22,36,58,.12)}
  .card-top{display:flex;align-items:center;gap:13px;margin-bottom:13px}
  .icon{width:42px;height:42px;border-radius:11px;flex-shrink:0;display:grid;place-items:center;background:var(--accent,var(--teal))}
  .icon svg{width:22px;height:22px;stroke:#fff;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .card h3{font-size:16.5px;font-weight:700;color:var(--ink);letter-spacing:-.01em;line-height:1.2}
  .card p{font-size:13.5px;color:var(--muted);margin-top:1px}
  .card .desc{font-size:13.5px;color:var(--text);margin-bottom:16px}
  .card .open{margin-top:auto;display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--accent,var(--teal))}
  .card .open svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .drive-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:var(--shadow)}
  .drive-card h3{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:19px;color:var(--ink);letter-spacing:-.01em;margin-bottom:4px}
  .drive-card .drive-sub{font-size:13px;color:var(--muted);margin-bottom:16px}
  .drive-card .desc{font-size:13.5px;color:var(--text);margin-bottom:14px}
  .drive-link{display:inline-flex;align-items:center;gap:7px;margin-top:12px;font-size:13px;font-weight:600;color:var(--drive-accent)}
  .drive-link svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:var(--shadow);position:sticky;top:24px}
  @media(max-width:980px){.panel{position:static}}
  .panel-head h3{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:19px;color:var(--ink);letter-spacing:-.01em}
  .panel-head p{font-size:12.5px;color:var(--muted);margin-top:4px;line-height:1.5}
  .rank-list{margin-top:18px;display:flex;flex-direction:column;gap:14px}
  .rank-item{display:flex;flex-direction:column;gap:6px}
  .rank-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
  .rank-name{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;color:var(--ink)}
  .rank-name .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
  .rank-name .you{font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#fff;background:var(--ink2);border-radius:5px;padding:1px 6px;margin-left:2px}
  .rank-count{font-size:13.5px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums}
  .rank-track{height:8px;border-radius:6px;background:var(--bg);overflow:hidden}
  .rank-fill{height:100%;border-radius:6px;transition:width .5s ease}
  .panel-foot{margin-top:18px;padding-top:14px;border-top:1px solid var(--line);font-size:11.5px;color:var(--muted);line-height:1.6}
  .ranking-link{display:inline-flex;align-items:center;gap:5px;margin-top:10px;font-size:12px;font-weight:600;color:var(--blue)}
  .ranking-link svg{width:13px;height:13px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
  footer{max-width:1180px;margin:0 auto;width:100%;padding:26px 24px 34px;margin-top:18px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted);line-height:1.7}
  footer b{color:var(--text);font-weight:600}
  @media(prefers-reduced-motion:reduce){.card{transition:none}.card:hover,.card:focus-visible{transform:none}.rank-fill{transition:none}}
</style>
</head>
<body>
<header class="masthead">
  <div class="mast-inner">
    <div class="mast-left">
      <div>
        <div class="eyebrow">Equipo Legislativo</div>
        <div class="mast-title">Jaime Mulet</div>
      </div>
      <div class="mast-sub">
        <span class="pill">Diputado</span>
        <span>Distrito 4</span><span class="dot"></span>
        <span>Región de Atacama</span><span class="dot"></span>
        <span>Federación Regionalista Verde Social</span>
      </div>
    </div>
    <div class="mast-right">
      <img class="mast-photo" src="data:image/jpeg;base64," alt="Foto del diputado Jaime Mulet">
    </div>
  </div>
</header>

<div class="layout">
  <main>
    <div class="section-label">Sala de la Cámara</div>
    <div class="grid">
      <a class="card" style="--accent:var(--yellow)" href="https://www.camara.cl/verDoc.aspx?prmId=0&prmTipo=TABLASEMANAL" target="_blank" rel="noopener">
        <div class="card-top">
          <span class="icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M8 13h2M14 13h2M8 17h2M14 17h2"/></svg></span>
          <div><h3>Tabla Semanal</h3><p>Orden del día de la semana</p></div>
        </div>
        <div class="desc">Los proyectos y materias agendados para las sesiones de Sala de la semana en curso.</div>
        <span class="open">Abrir en camara.cl <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
      </a>
      <a class="card" style="--accent:var(--pink)" href="https://www.camara.cl/sala/default.aspx" target="_blank" rel="noopener">
        <div class="card-top">
          <span class="icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><circle cx="12" cy="15" r="2.4"/></svg></span>
          <div><h3>Tabla del día</h3><p>Sesión más cercana</p></div>
        </div>
        <div class="desc">El trabajo en Sala de la sesión vigente: orden del día, cuenta y documentos sobre tabla.</div>
        <span class="open">Abrir en camara.cl <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
      </a>
    </div>

    <div class="section-label mt">Citaciones de Comisiones</div>
    <div class="grid">
      <a class="card" style="--accent:var(--red)" href="https://www.camara.cl/legislacion/comisiones/citaciones.aspx?prmID=3308&prmIdTipo=2101" target="_blank" rel="noopener">
        <div class="card-top">
          <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <div><h3>Constitución</h3><p>Constitución, Legislación, Justicia y Reglamento</p></div>
        </div>
        <div class="desc">Citaciones de la Comisión: fecha de la próxima sesión y tabla de materias a tratar.</div>
        <span class="open">Abrir en camara.cl <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
      </a>
      <a class="card" style="--accent:var(--green)" href="https://www.camara.cl/legislacion/comisiones/citaciones.aspx?prmID=5002&prmIdTipo=2101" target="_blank" rel="noopener">
        <div class="card-top">
          <span class="icon"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/><path d="M3 6h18"/></svg></span>
          <div><h3>Obras Públicas</h3><p>Obras Públicas, Transportes y Telecomunicaciones</p></div>
        </div>
        <div class="desc">Citaciones de la Comisión: fecha de la próxima sesión y tabla de materias a tratar.</div>
        <span class="open">Abrir en camara.cl <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
      </a>
    </div>

    <div class="section-label mt">Actividad Legislativa</div>
    <div class="grid">
      <a class="card" style="--accent:var(--blue)" href="https://www.camara.cl/diputados/detalle/mociones.aspx?prmId=1168" target="_blank" rel="noopener">
        <div class="card-top">
          <span class="icon"><svg viewBox="0 0 24 24"><path d="M9 2h6l1 4H8l1-4Z"/><path d="M7 6h10l1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L7 6Z"/><path d="M10 11h4M10 15h4"/></svg></span>
          <div><h3>Mociones</h3><p>Proyectos de ley de Mulet</p></div>
        </div>
        <div class="desc">Listado oficial de mociones presentadas por el diputado Jaime Mulet en la Cámara.</div>
        <span class="open">Abrir en camara.cl <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
      </a>
    </div>

    <div class="section-label mt">Documentos y Minutas</div>
    <div class="drive-card">
      <h3>Minutas y Proyectos de Ley</h3>
      <div class="drive-sub">Documentos de trabajo del diputado</div>
      <p class="desc">Todas las minutas y proyectos de ley preparados por el equipo, organizados en Google Drive.</p>
      <a href="https://drive.google.com/drive/folders/15LRWcZB13qHlK2SF4oBM2M3zTREsAt7A" target="_blank" rel="noopener"
         style="display:flex;align-items:center;gap:16px;padding:18px 20px;background:#f8faff;border:1.5px solid #dde3ec;border-radius:12px;text-decoration:none;color:inherit;transition:box-shadow .18s ease;"
         onmouseover="this.style.boxShadow='0 4px 14px rgba(30,58,95,.12)'"
         onmouseout="this.style.boxShadow='none'">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><rect width="40" height="40" rx="8" fill="#E8F0FE"/><path d="M14 26l5-8.66h10L24 26H14z" fill="#4285F4"/><path d="M11 21l5-8.66 5 8.66H11z" fill="#0F9D58"/><path d="M24 17.34L29 26H19l5-8.66z" fill="#FBBC04"/></svg>
        <div>
          <div style="font-weight:700;font-size:14.5px;color:#16243a">Carpeta Bancada DC en Google Drive</div>
          <div style="font-size:12.5px;color:#7c8aa0;margin-top:2px">Minutas, proyectos de ley y documentos de trabajo</div>
        </div>
        <svg style="margin-left:auto;flex-shrink:0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c8aa0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
      <a class="drive-link" href="https://drive.google.com/drive/folders/15LRWcZB13qHlK2SF4oBM2M3zTREsAt7A" target="_blank" rel="noopener">
        Abrir carpeta en Google Drive
        <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </main>

  <aside class="panel" aria-label="Ranking de mociones del Distrito 4">
    <div class="panel-head">
      <h3>Mociones · Distrito 4</h3>
      <p>Proyectos de ley presentados por cada diputado/a en el período 2026–2030.</p>
    </div>
    <div class="rank-list" id="rankList"></div>
    <div class="panel-foot">
      Fuente: Cámara de Diputadas y Diputados de Chile (camara.cl). Se actualiza automáticamente una vez al día.
      <div id="rankFecha" style="margin-top:4px;font-weight:600"></div>
      <a class="ranking-link" href="https://equipo-patricio-pinilla.vercel.app/ranking.html" target="_blank" rel="noopener">
        Ver ranking general (155 diputados) →
        <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </aside>
</div>

<footer>
  <div>Los accesos abren las páginas oficiales de la <b>Cámara de Diputadas y Diputados de Chile</b> (camara.cl), que se actualizan en tiempo real. Esta página solo enlaza esas fuentes.</div>
  <div style="margin-top:10px">Sitio creado por <b>Bancada DC - JCCH</b>.</div>
</footer>

<script>
  const NOMBRES_DISTRITO_4 = [
    "Jaime Mulet Martínez",
    "Cristián Tapia Ramos",
    "Juan Santana Castillo",
    "Paula Olmos Arroyo",
    "Ignacio Urcullu Tagle",
  ];

  const COLOR_POR_NOMBRE = {
    "Jaime Mulet Martínez":   "var(--rk-mulet)",
    "Cristián Tapia Ramos":   "var(--rk-tapia)",
    "Juan Santana Castillo":  "var(--rk-santana)",
    "Paula Olmos Arroyo":     "var(--rk-olmos)",
    "Ignacio Urcullu Tagle":  "var(--rk-urcullu)",
  };

  const RESPALDO = NOMBRES_DISTRITO_4.map(n => ({nombre: n, mociones: 0}));

  function normalizar(s) {
    return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
  }

  function renderRanking(data, actualizado) {
    const ord = [...data].sort((a,b) => b.mociones - a.mociones);
    const max = Math.max(...ord.map(d => d.mociones), 1);
    document.getElementById("rankList").innerHTML = ord.map(d => {
      const color = COLOR_POR_NOMBRE[d.nombre] || "var(--muted)";
      const esMulet = d.nombre === "Jaime Mulet Martínez";
      return `<div class="rank-item">
        <div class="rank-row">
          <span class="rank-name">
            <span class="dot" style="background:${color}"></span>
            ${d.nombre}
            ${esMulet ? '<span class="you">Nuestro diputado</span>' : ""}
          </span>
          <span class="rank-count">${d.mociones}</span>
        </div>
        <div class="rank-track">
          <div class="rank-fill" style="width:${(d.mociones/max*100).toFixed(0)}%;background:${color}"></div>
        </div>
      </div>`;
    }).join("");
    const el = document.getElementById("rankFecha");
    if (el && actualizado) {
      el.textContent = "Última actualización: " + new Date(actualizado).toLocaleDateString("es-CL", {day:"numeric",month:"long",year:"numeric"});
    }
  }

  async function cargarRanking() {
    try {
      const resp = await fetch("https://equipo-patricio-pinilla.vercel.app/api/ranking");
      const data = await resp.json();
      if (!data?.ranking || data.error) throw new Error("Sin datos");
      const mocionesMap = {};
      data.ranking.forEach(d => { mocionesMap[normalizar(d.nombre)] = d.mociones; });
      const d4 = NOMBRES_DISTRITO_4.map(nombre => ({
        nombre, mociones: mocionesMap[normalizar(nombre)] ?? 0
      }));
      renderRanking(d4, data.actualizado);
    } catch(e) {
      renderRanking(RESPALDO, null);
    }
  }

  cargarRanking();
</script>

<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register("/service-worker.js").catch(() => {});
    });
  }
</script>
</body>
</html>
